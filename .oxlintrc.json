{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "react", "oxc", "unicorn", "typescript", "vitest"],
  "rules": {
    "no-unused-vars": "off",
    "react/exhaustive-deps": "off"
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/out",
    ".gitignore",
    ".github",
    ".cursor",
    ".vscode",
    "build/**",
    "resources/**",
    "scripts/**",
    "runtime/**",
    "docs/**",
    "test/**",
    "src/shared/**",
    "src/shadcn/**"
  ]
}
