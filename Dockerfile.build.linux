FROM oven/bun:1.3.14

# Configure npm registry mirror (used by electron-builder and other tools that still invoke npm)
RUN npm config set registry https://registry.npmmirror.com

RUN ldd --version
# Install build-required system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy project files
COPY . .

# Install dependencies
RUN bun install \
    && bun run installRuntime:linux:x64 \
    && bun install --cpu=wasm32 sharp

# Build command
CMD ["bun", "run", "build:linux:x64"]
