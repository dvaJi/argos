{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["out/**"],
      "env": ["VITE_GITHUB_CLIENT_ID", "VITE_GITHUB_REDIRECT_URI", "VITE_PROVIDER_DB_URL"],
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "packaging:validate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/scripts/validate-packaging-inputs.mjs"]
    }
  }
}
