{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/assets/**/*",
    "src/renderer/floating/env.d.ts",
    "src/renderer/floating/**/*",
    "src/renderer/floating/**/*.tsx",
    "src/renderer/floating/assets/**/*",
    "src/renderer/splash/**/*",
    "src/renderer/splash/**/*.tsx",
    "src/renderer/splash/assets/**/*",
    "src/preload/*.d.ts",
    "src/renderer/api/**/*",
    "src/shared/**/*",
    "src/shadcn/**/*",
    "src/renderer/settings/**/*",
    "src/renderer/settings/**/*.tsx"
  ],
  "compilerOptions": {
    "module": "esnext",
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ],
      "@api/*": [
        "./src/renderer/api/*"
      ],
      "@shared/contracts/*": [
        "../../packages/shared-contracts/src/*"
      ],
      "@shared/*": [
        "../../packages/shared/src/*"
      ],
      "@shadcn/*": [
        "./src/shadcn/*"
      ],
      "@settings/*": [
        "./src/renderer/settings/*"
      ]
    }
  }
}
