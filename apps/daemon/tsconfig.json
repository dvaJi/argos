{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "paths": {
      "@argos/acp-runtime": ["../../packages/acp-runtime/src"],
      "@argos/acp-runtime/*": ["../../packages/acp-runtime/src/*"],
      "@argos/mcp-runtime": ["../../packages/mcp-runtime/src"],
      "@argos/mcp-runtime/*": ["../../packages/mcp-runtime/src/*"],
      "@argos/skills-runtime": ["../../packages/skills-runtime/src"],
      "@argos/skills-runtime/*": ["../../packages/skills-runtime/src/*"],
      "@argos/memory-runtime": ["../../packages/memory-runtime/src"],
      "@argos/memory-runtime/*": ["../../packages/memory-runtime/src/*"],
      "@argos/remote-control-runtime": ["../../packages/remote-control-runtime/src"],
      "@argos/remote-control-runtime/*": ["../../packages/remote-control-runtime/src/*"],
      "@argos/backend-core": ["../../packages/backend-core/src"],
      "@argos/backend-core/*": ["../../packages/backend-core/src/*"],
      "@argos/shared-contracts": ["../../packages/shared-contracts/src"],
      "@argos/shared-contracts/*": ["../../packages/shared-contracts/src/*"],
      "@shared/contracts/*": ["../../packages/shared-contracts/src/*"],
      "@shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
