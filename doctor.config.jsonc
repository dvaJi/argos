// React Doctor configuration.
// https://react.doctor/docs — managed via `npx react-doctor@latest rules …`
{
  "$schema": "https://www.react.doctor/schemas/doctor-config.schema.json",
  "rules": {
    // BUILD-TIME COMPILER LIVE (verified: compiler-runtime chunk in dist).
    // Manual memoization removal pass tracked in #78; rules re-enabled.
    "react-doctor/react-compiler-no-manual-memoization": "error",
    "react-doctor/no-usememo-simple-expression": "error",
    // POLICY (2026-08): `no-adjust-state-on-prop-change` conflicts with the
    // compiler-endorsed "adjust state during render" pattern (prev-compare)
    // used to reset drafts — oxlint's compiler rules approve these sites.
    "react-doctor/no-adjust-state-on-prop-change": "off",
    // POLICY (2026-08): `async-defer-await` in mcpSampling — `ensureModelsReady()`
    // must be awaited to determine readiness; there is no skip path that avoids it.
    "react-doctor/async-defer-await": "off",
    // POLICY (2026-08): oxlint's React Compiler rules (enabled as errors in .oxlintrc.json)
    // are the authority for effect dependencies in this repo; the classic
    // exhaustive-deps rule disagrees with compiler-approved latest-ref and
    // stabilized-deps patterns fixed in PR #75. Revisit per finding.
    "react-doctor/exhaustive-deps": "off",
  },
}
