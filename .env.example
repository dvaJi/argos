# GitHub OAuth Configuration for GitHub Copilot
# Copy this file to .env and fill in the actual values.
#
# The desktop app only needs the Client ID. The Client SECRET is no longer
# bundled with the desktop binary — it lives on the landing page relay
# (apps/landing) as a Cloudflare Worker secret. Set it with:
#   pnpm --filter @argos/landing exec wrangler secret put GITHUB_CLIENT_SECRET
VITE_GITHUB_CLIENT_ID=Iv1.b507a08c87ecfe98
VITE_GITHUB_REDIRECT_URI=https://argos.aipurrjects.xyz/auth/github/callback
VITE_LOG_IPC_CALL=0

VITE_APP_LIFECYCLE_HOOK_DELAY=0
VITE_PROVIDER_DB_URL=https://raw.githubusercontent.com/ThinkInAIXYZ/PublicProviderConf/refs/heads/dev/dist/all.json
