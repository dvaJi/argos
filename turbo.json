{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:node": {
      "dependsOn": ["^build"]
    },
    "typecheck:web": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {},
    "format:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
